#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APP ICON "phonemirror.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PM_VERSION_MAJOR, PM_VERSION_MINOR, PM_VERSION_PATCH, 0
PRODUCTVERSION PM_VERSION_MAJOR, PM_VERSION_MINOR, PM_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "PhoneMirror"
      VALUE "FileVersion", PM_VERSION_STRING
      VALUE "InternalName", "PhoneMirror"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "PhoneMirror.exe"
      VALUE "ProductName", "PhoneMirror"
      VALUE "ProductVersion", PM_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
